import Zcash.Meta.Instrument

/-! Tests of the `Costed` registry: the built-in instances resolve and are first order where
they should be; a hand-written instance is refused until registered, and reported once it is. -/

namespace Zcash.Meta.Tests.Instrument

open Lean Elab Term Meta Zcash.Meta.Instrument

/-- info: first order: true, trusted: [] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List (Nat × Option Bool)))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

/-- info: first order: false, trusted: [] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List (Nat → Nat)))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

structure Pair where
  a : Nat
  b : Nat

/-- A hand-written instance, which the derivation refuses until it is registered. -/
instance instCostedPair : Costed Pair := Costed.firstOrder Pair

/--
error: efficient: the `Costed` instance `Zcash.Meta.Tests.Instrument.instCostedPair`, which `Pair` resolves to, is not registered, so the derivation does not trust it. An instance written by hand is a trusted assumption about cost; register it with `register_costed Zcash.Meta.Tests.Instrument.instCostedPair` to say so
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| costedInstance (mkConst ``Pair)

register_costed instCostedPair

/-- info: first order: true, trusted: [Zcash.Meta.Tests.Instrument.instCostedPair] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List Pair))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

/-- error: register_costed: `Zcash.Meta.Tests.Instrument.instCostedPair` is already registered as Zcash.Meta.Instrument.Provenance.registered -/
#guard_msgs in
register_costed instCostedPair

/-- error: register_costed: `Nat.succ` is not a `Costed` instance -/
#guard_msgs in
register_costed Nat.succ

/--
error: efficient: no `Costed` instance for `Prop → Nat`: its costed form is not known. An inductive type gets one generated by the derivation; a type that the derivation cannot read needs an instance written by hand and registered with `register_costed`, which is a trusted assumption about cost
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| costedInstance (← elabType (← `(Prop → Nat)))

end Zcash.Meta.Tests.Instrument
