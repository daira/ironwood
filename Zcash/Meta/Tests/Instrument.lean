import Zcash.Meta.Instrument

/-! Tests of the `Costed` registry: the built-in instances resolve and are first order where
they should be; a hand-written instance is refused until registered, and reported once it is;
a first-order inductive type gets its identity instance generated. -/

namespace Zcash.Meta.Tests.Instrument

open Lean Elab Term Meta Zcash.Meta.Instrument

/-- info: first order: true, trusted: [] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List (Nat × Option Bool)))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

/-- info: first order: false, trusted: [] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List (Nat → Nat)))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

structure Pair where
  a : Nat
  b : Nat

/-- A hand-written instance, which the derivation refuses until it is registered. -/
instance instCostedPair : Costed Pair := Costed.firstOrder Pair

/--
error: efficient: the `Costed` instance `Zcash.Meta.Tests.Instrument.instCostedPair`, which `Pair`
resolves to, is not registered, so the derivation does not trust it. An instance written by hand is
a trusted assumption about cost; register it with
`register_costed Zcash.Meta.Tests.Instrument.instCostedPair` to say so
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| costedInstance (mkConst ``Pair)

register_costed instCostedPair

/-- info: first order: true, trusted: [Zcash.Meta.Tests.Instrument.instCostedPair] -/
#guard_msgs in
run_elab do
  let t ← elabType (← `(List Pair))
  let (_, trusted) ← costedInstance t
  logInfo m!"first order: {← isFirstOrder t}, trusted: {trusted}"

/--
error: register_costed: `Zcash.Meta.Tests.Instrument.instCostedPair` is already registered as
Zcash.Meta.Instrument.Provenance.registered
-/
#guard_msgs (whitespace := lax) in
register_costed instCostedPair

/-- error: register_costed: `Nat.succ` is not a `Costed` instance -/
#guard_msgs in
register_costed Nat.succ

/--
error: efficient: no `Costed` instance for `Prop → Nat`: its costed form is not known. An inductive
type gets one generated by the derivation; a type that the derivation cannot read needs an instance
written by hand and registered with `register_costed`, which is a trusted assumption about cost
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| costedInstance (← elabType (← `(Prop → Nat)))

/-! ## Generated identity instances: a structure of first-order fields, a value-parametric one,
and a recursive inductive, each first order; a structure with a function field, and one with a
type parameter, which need a mirror. -/

structure Point where
  x : Nat
  y : Nat

/-- info: first order: true, trusted: [], instance: Point.instCosted -/
#guard_msgs in
run_elab do
  let (inst, trusted) ← ensureCosted (mkConst ``Point)
  logInfo m!"first order: {← isFirstOrder (mkConst ``Point)}, trusted: {trusted}, \
    instance: {inst}"

structure Window (n : Nat) where
  cells : List (Fin n)
  origin : Point

/-- info: first order: true -/
#guard_msgs in
run_elab do
  logInfo m!"first order: {← isFirstOrder (← elabType (← `(Window 4)))}"

inductive Tree where
  | leaf
  | node (l r : Tree) (v : Nat)

/-- info: first order: true -/
#guard_msgs in
run_elab do
  logInfo m!"first order: {← isFirstOrder (← elabType (← `(List Tree)))}"

structure Stepper where
  step : Nat → Nat
  limit : Nat

/--
error: efficient: the field `step` of `Zcash.Meta.Tests.Instrument.Stepper.mk` has type `Nat → Nat`,
which holds a function, so the costed form of `Zcash.Meta.Tests.Instrument.Stepper` is a mirror with
that field's costed form, which is not generated yet; write an instance and register it with
`register_costed`
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| ensureCosted (mkConst ``Stepper)

structure Box (α : Type) where
  item : α

/--
error: efficient: `Zcash.Meta.Tests.Instrument.Box` has the type parameter `α`, so its costed
form is a mirror at the costed forms of its parameters, which is not generated yet; write an
instance and register it with `register_costed`
-/
#guard_msgs (whitespace := lax) in
run_elab do
  discard <| ensureCosted (← elabType (← `(Box Nat)))

end Zcash.Meta.Tests.Instrument
