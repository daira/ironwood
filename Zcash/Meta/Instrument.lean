import Lean
import Zcash.Meta.Costed
import Zcash.Meta.CostedRegistry

/-!
# The instrumented translation: costed forms of types

The derivation of a cost function needs, for each type it meets, the type's costed form
(`Costed.WithCosts`) and the instance that gives it. The registry of `Costed` instances
(`Zcash.Meta.CostedRegistry`) records each instance's provenance, which is what makes the trusted
base determinable: an instance is either built in (the structural instances of `Zcash.Meta.Costed`),
generated by the derivation for an inductive type after reading its constructors, or written by hand
and registered with `register_costed`, in which case it is a trusted assumption about cost. The
derivation accepts an instance only from this registry, so a `Costed` instance declared anywhere
else is refused rather than trusted. See the documentation of `Zcash.Meta.Costed` for what an
instance asserts and why that cannot be a law.
-/

open Lean Elab Command Meta Term

namespace Zcash.Meta.Instrument

/-- The instances of `Zcash.Meta.Costed`, registered as built in below. -/
def builtinInstances : Array Name :=
  #[``Costed.instNat, ``Costed.instInt, ``Costed.instBool, ``Costed.instPUnit, ``Costed.instChar,
    ``Costed.instString, ``Costed.instFin, ``Costed.instUInt8, ``Costed.instUInt16,
    ``Costed.instUInt32, ``Costed.instUInt64, ``Costed.instPi, ``Costed.instList,
    ``Costed.instArray, ``Costed.instOption, ``Costed.instProd, ``Costed.instSum,
    ``Costed.instSigma, ``Costed.instSubtype]

run_cmd
  for n in builtinInstances do
    modifyEnv (costedExt.addEntry · { inst := n, provenance := .builtin })

/-- Whether the constant `c` is a `Costed` instance: its type, under its binders, is an application
of `Costed`. -/
def isCostedInstance (c : Name) : MetaM Bool := do
  let some info := (← getEnv).find? c | return false
  forallTelescopeReducing info.type fun _ body => return body.getAppFn.isConstOf ``Costed

/-- The `Costed` instance for the type `t`, found by instance synthesis and checked against the
registry: every `Costed` instance that the synthesized term uses must be registered, as built
in, generated, or hand-written. Returns the instance and the hand-written instances it uses,
which are the trusted assumptions that a derivation through `t` rests on. -/
def costedInstance (t : Expr) : MetaM (Expr × Array Name) := do
  let u ← getLevel t
  let some v := u.dec
    | throwError "efficient: `{t}` is not a type in some `Type u`, so it has no costed form"
  let cls := mkApp (mkConst ``Costed [v]) t
  let inst ← try synthInstance cls
    catch _ => throwError "efficient: no `Costed` instance for `{t}`: its costed form is not \
      known. An inductive type gets one generated by the derivation; a type that the \
      derivation cannot read needs an instance written by hand and registered with \
      `register_costed`, which is a trusted assumption about cost"
  let env ← getEnv
  let mut trusted := #[]
  for c in inst.getUsedConstants do
    if ← isCostedInstance c then
      match costedEntry? env c with
      | some { provenance := .registered, .. } => trusted := trusted.push c
      | some _ => pure ()
      | none => throwError "efficient: the `Costed` instance `{c}`, which `{t}` resolves to, is \
          not registered, so the derivation does not trust it. An instance written by hand \
          is a trusted assumption about cost; register it with `register_costed {c}` to say so"
  return (inst, trusted)

/-- Whether the costed form of `t` is `t` itself: `t` holds no function, so a derived cost function
can take `t` where `WithCosts t` would be. The two are compared at default transparency, which is
what type-checking the derived function uses. -/
def isFirstOrder (t : Expr) : MetaM Bool := do
  let (inst, _) ← costedInstance t
  let u ← getLevel t
  let withCosts := mkApp2 (mkConst ``Costed.WithCosts [u.dec.get!]) t inst
  withDefault (isDefEq withCosts t)

/-- `register_costed inst` registers the hand-written `Costed` instance `inst` as a trusted
assumption about cost: that the costed form it gives carries every function inside a value of
its type, with instrumented versions that report their calls' costs. The derivation reports
such instances, per pinned definition, as `#print axioms` reports axioms. -/
syntax (name := registerCosted) "register_costed " ident : command

@[command_elab registerCosted] def elabRegisterCosted : CommandElab
  | `(register_costed $inst:ident) => do
    let c ← liftCoreM (realizeGlobalConstNoOverloadWithInfo inst)
    unless ← liftTermElabM (isCostedInstance c) do
      throwError "register_costed: `{c}` is not a `Costed` instance"
    if let some e := costedEntry? (← getEnv) c then
      throwError "register_costed: `{c}` is already registered as {repr e.provenance}"
    modifyEnv (costedExt.addEntry · { inst := c, provenance := .registered })
  | _ => throwUnsupportedSyntax

end Zcash.Meta.Instrument
