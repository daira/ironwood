import Lean

/-!
# The registry of `Costed` instances

The registry records every `Costed` instance that the derivation of a cost function may use,
with its provenance, which is what makes the trusted base determinable. It lives in a module of
its own because an environment extension cannot be used in the module that declares it, and
`Zcash.Meta.Instrument` fills it with the built-in instances as soon as it is imported.
-/

open Lean

namespace Zcash.Meta.CostedRegistry

/-- Where a `Costed` instance comes from, which decides what it asserts. -/
inductive Provenance where
  /-- One of the structural instances of `Zcash.Meta.Costed`: the primitive first-order types,
  function types, and the parametric inductives that are their own mirrors. -/
  | builtin
  /-- Generated by the derivation for an inductive type, after reading its constructors. -/
  | generated
  /-- Written by hand and registered with `register_costed`: a trusted assumption about cost. -/
  | registered
  deriving Inhabited, Repr, BEq

/-- The provenance, in words, for a message. -/
def Provenance.describe : Provenance → String
  | .builtin => "built in"
  | .generated => "generated"
  | .registered => "hand-written"

/-- A registered `Costed` instance: the instance's declaration and where it comes from. -/
structure CostedEntry where
  inst : Name
  provenance : Provenance
  deriving Inhabited, Repr

/-- The registry of `Costed` instances, by the instance's declaration. -/
initialize costedExt : SimplePersistentEnvExtension CostedEntry (NameMap CostedEntry) ←
  registerSimplePersistentEnvExtension {
    addEntryFn := fun m e => m.insert e.inst e
    addImportedFn := fun ess => ess.foldl (fun m es => es.foldl (fun m e => m.insert e.inst e) m) {}
  }

/-- The registry entry of the instance `inst`, if any. -/
def costedEntry? (env : Environment) (inst : Name) : Option CostedEntry :=
  (costedExt.getState env).find? inst

end Zcash.Meta.CostedRegistry
